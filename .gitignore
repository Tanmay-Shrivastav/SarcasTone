# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.so

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual Environments
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# Jupyter Notebook & Colab artifacts
.ipynb_checkpoints/
*/.ipynb_checkpoints/*
drive/
/content/

# IDE / Editor artifacts
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# Raw datasets & media files (keep heavy raw datasets out of git)
/data/
/data/raw/
*.avi
*.flac

# Cached tensors & feature representations (.pt, .pth, .npy, .npz, .h5)
/cache/
*.pth
*.npy
*.npz
*.h5

# Model checkpoints & training weights
/checkpoints/
*.ckpt
model_weights/

# Ignore general media and tensor files by default
*.mp4
*.wav
*.mp3
*.pt

# Whitelist: Frontend web app assets (UI clips, demo data, icons)
!frontend/
!frontend/**
!frontend/assets/clips/*.mp4
!frontend/assets/clips/*.wav
!frontend/assets/clips/*.jpg
!frontend/data/demo_data.json

# Whitelist: Trained champion checkpoint & ablation experimental summaries
!results/
!results/**
!results/full_multimodal_pgin/
!results/full_multimodal_pgin/best_model.pt
!results/full_multimodal_pgin/metrics.json
!results/ablation_summary.json
!results/ablation_summary.csv
!results/ablation_summary.md
!results/*.png

# Experiment results, logs, and profiling
/temp_results/
/logs/
wandb/
runs/
.pytest_cache/
.coverage
htmlcov/
